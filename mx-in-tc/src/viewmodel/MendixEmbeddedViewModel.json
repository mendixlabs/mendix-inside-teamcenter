{
  "schemaVersion": "1.0.0",
  "ctx": {
    "selected": null
  },
  "data": {
    "containerRef": {
      "current": null
    },
    "errorCode": "",
    "errorMessage": ""
  },
  "actions": {
    "loadMendix": {
      "actionType": "JSFunctionAsync",
      "method": "loadMendix",
      "deps": "js/mendixEmbeddedService",
      "inputData": {
        "containerRef": "{{data.containerRef}}",
        "config": "{{props.config}}",
        "subPanelContext": "{{props.subPanelContext}}",
        "context": "{{ctx}}",
        "reloadAction": "{{actions.loadMendix}}"
      },
      "outputData": {
        "errorCode": "errorCode",
        "errorMessage": "errorMessage"
      }
    },
    "cleanup": {
      "actionType": "JSFunction",
      "method": "mendixCleanupFunction",
      "deps": "js/mendixEmbeddedService",
      "inputData": {
        "containerRef": "{{data.containerRef}}"
      }
    }
  },
  "conditions": {
    "hasError": {
      "expression": "Boolean(data.errorMessage)"
    },
    "isPopupBlocked": {
      "expression": "data.errorCode === 'POPUP_BLOCKED'"
    },
    "hasGeneralError": {
      "expression": "data.errorMessage && data.errorCode !== 'POPUP_BLOCKED'"
    }
  },
  "lifecycleHooks": {
    "onUpdate": [
      {
        "action": "loadMendix",
        "observers": [
          "props.config",
          "props.subPanelContext.declarativeKeyContext",
          "viewModel.ctx"
        ]
      }
    ],
    "onUnmount": "cleanup"
  },
  "onEvent": [],
  "i18n": {},
  "messages": {},
  "props": {
    "config": {
      "type": "string"
    },
    "subPanelContext": {
      "type": "object"
    }
  }
}