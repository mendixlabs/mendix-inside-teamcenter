{
  "schemaVersion": "1.0.0",
  "ctx": {
    "mendixContext": {
      "parser": {
        "method": "getMendixContextDerivedState",
        "deps": "js/mendixEmbeddedContextService"
      }
    }
  },
  "data": {
    "containerRef": {
      "current": null
    },
    "error": null,
    "loadRequestId": null
  },
  "actions": {
    "loadMendix": {
      "actionType": "JSFunction",
      "method": "requestMendixLoad",
      "deps": "js/mendixEmbeddedService",
      "outputData": {
        "error": "error",
        "loadRequestId": "loadRequestId"
      }
    },
    "mountMendix": {
      "actionType": "JSFunctionAsync",
      "method": "mountMendix",
      "deps": "js/mendixEmbeddedService",
      "inputData": {
        "containerRef": "{{data.containerRef}}",
        "loadRequestId": "{{data.loadRequestId}}",
        "config": "{{props.config}}",
        "subPanelContext": "{{props.subPanelContext}}",
        "context": "{{ctx.mendixContext[0]}}",
        "reloadAction": "{{actions.loadMendix}}"
      },
      "outputData": {
        "error": "error"
      }
    },
    "cleanup": {
      "actionType": "JSFunction",
      "method": "mendixCleanupFunction",
      "deps": "js/mendixEmbeddedService",
      "inputData": {
        "containerRef": "{{data.containerRef}}"
      }
    },
    "reload": {
      "actionType": "JSFunction",
      "method": "reloadPage",
      "deps": "js/mendixEmbeddedService"
    }
  },
  "conditions": {
    "isPopupBlocked": {
      "expression": "data.error && data.error.code === 'POPUP_BLOCKED'"
    },
    "hasGeneralError": {
      "expression": "data.error && data.error.code !== 'POPUP_BLOCKED'"
    }
  },
  "lifecycleHooks": {
    "onUpdate": [
      {
        "action": "loadMendix",
        "observers": [
          "props.config",
          "props.subPanelContext.declarativeKeyContext",
          "viewModel.ctx.mendixContext.0"
        ]
      },
      {
        "action": "mountMendix",
        "observers": [
          "viewModel.data.loadRequestId"
        ]
      }
    ],
    "onUnmount": "cleanup"
  },
  "onEvent": [],
  "i18n": {},
  "messages": {},
  "props": {
    "config": {
      "type": "string"
    },
    "subPanelContext": {
      "type": "object"
    }
  }
}