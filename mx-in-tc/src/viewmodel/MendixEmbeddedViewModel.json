{
  "schemaVersion": "1.0.0",
  "ctx": {
    "mendixContext": {
      "parser": {
        "method": "getMendixContextDerivedState",
        "deps": "js/mendixEmbeddedContextService"
      }
    }
  },
  "data": {
    "errorCode": null
  },
  "actions": {
    "render": {
      "method": "mendixEmbeddedRenderFunction",
      "deps": "js/mendixEmbeddedService",
      "options": {
        "elementRefList": [ "mendixContainer" ]
      }
    },
    "loadMendix": {
      "actionType": "JSFunctionAsync",
      "method": "mountMendix",
      "deps": "js/mendixEmbeddedService",
      "inputData": {
        "elementRefList": "{{parameters.elementRefList}}",
        "config": "{{props.config || props.subPanelContext.declarativeKeyContext}}",
        "context": "{{ctx.mendixContext[0]}}",
        "reloadAction": "{{actions.loadMendix}}"
      },
      "outputData": {
        "errorCode": "errorCode"
      }
    },
    "cleanup": {
      "actionType": "JSFunction",
      "method": "mendixCleanupFunction",
      "deps": "js/mendixEmbeddedService",
      "inputData": {
        "elementRefList": "{{parameters.elementRefList}}"
      }
    },
    "reload": {
      "actionType": "JSFunction",
      "method": "reloadPage",
      "deps": "js/mendixEmbeddedService"
    }
  },
  "lifecycleHooks": {
    "render": "render",
    "onUpdate": {
      "action": "loadMendix",
      "observers": [ "viewModel.ctx.mendixContext.0" ]
    },
    "onUnmount": "cleanup"
  },
  "props": {
    "config": {
      "type": "string"
    },
    "subPanelContext": {
      "type": "object"
    }
  }
}
